# Настройки подключений SAQ Qurylys. Скопируйте в .env(корень репозитория, вне Git) и заполните на сервере.
# Пустое значение - то же, что не задано: подключение показывается как "не настроен" и ничего не запрашивает.
# Секреты генерировать так: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# После изменения .env: docker compose up -d api worker(или перезапуск ./dev.sh)
# Значения пишутся без кавычек и читаются буквально: "$" экранировать не нужно(в Docker кавычки вокруг значения
# стали бы частью значения - env_file с format: raw).
# Пошагово для каждого подключения(токен Meta, вход в Telegram, Apify, 2ГИС, Krisha, OLX) - docs/INTEGRATIONS.md.
# Полная таблица переменных со значениями по умолчанию и границами - docs/DEPLOYMENT.md, "Переменные окружения".
# Проверка из консоли: cd backend && .venv/bin/python -m app.integrations.smoke

# ---------- Доступ к API ----------
# Токен администратора подключений(заголовок X-Admin-Token): ≥ 24 символов, ≥ 12 разных, не равен другим токенам
SAQ_ADMIN_TOKEN=
# Токен внешних сборщиков для POST /api/intake/publications(Authorization: Bearer)
INTEGRATION_INGEST_TOKEN=
# Сервисный токен приёмника Telegram-бота заявок(тот же, что SERVICE_API_TOKEN в проекте saq-telegram-bot)
SERVICE_API_TOKEN=

# ---------- Docker: база данных и доступ к интерфейсу ----------
# Пароль PostgreSQL: его читает только docker-compose.yml(для db и DATABASE_URL api и воркера), не приложение.
# Только латинские буквы и цифры(пароль входит в DATABASE_URL); пусто - "saq". Действует при создании тома pgdata;
# у существующей базы сначала docker compose exec db psql -U saq -c "ALTER USER saq PASSWORD '<новый>'", затем
# новый пароль - сюда и docker compose up -d
SAQ_DB_PASSWORD=
# Кто кроме этой машины открывает интерфейс(сервис web, порт 5180, вместе с /api): IP или подсети через запятую,
# обычно устройства Tailscale, например 100.101.102.103. Пусто - только эта машина; остальные соединения Vite рвёт
# сразу(frontend/vite.config.ts). Эту переменную читает только docker-compose.yml; после правки -
# docker compose up -d web
SAQ_ALLOWED_CLIENTS=
# Имена, по которым открывают интерфейс кроме localhost и IP(например имя машины в Tailscale MagicDNS), через запятую;
# ".домен" - домен и все его поддомены. Читают и Vite(сервис web), и API: запрос с другим именем в Host отклоняют
# оба(API - 400: защита от подмены DNS). После правки - docker compose up -d web api
SAQ_WEB_HOSTS=

# ---------- Meta, Instagram(Graph API, Business Discovery) ----------
# ID и секрет приложения - по желанию: срок токена проверяется токеном приложения, к запросам добавляется appsecret_proof
META_APP_ID=
META_APP_SECRET=
# долгосрочный токен пользователя(60 дней) или токен системного пользователя; продление - docs/INTEGRATIONS.md, "Instagram"
META_USER_ACCESS_TOKEN=
# по умолчанию v26.0
META_GRAPH_VERSION=
# публичные ID проекта: бизнес-портфолио 1000000000000001, Страница 1000000000000002,
# Instagram 17840000000000001(без META_IG_USER_ID профиль ищется по Страницам токена, затем по бизнес-портфолио)
META_BUSINESS_ID=
META_PAGE_ID=
META_IG_USER_ID=
# публикаций на страницу запроса(25) и не больше публикаций при первой загрузке аккаунта(50)
IG_PAGE_SIZE=
IG_FIRST_LOAD_MAX=

# ---------- Telegram: выделенный аккаунт для чтения публичных каналов(MTProto) ----------
TG_API_ID=
TG_API_HASH=
# телефон аккаунта - только для входа(python -m app.integrations.telegram_login)
TG_PHONE=
# файл сессии - секрет; по умолчанию backend/data/private/telegram.session(в Docker путь задаёт docker-compose.yml -
# /data/private/telegram.session на томе только воркера, значение отсюда не действует)
TG_SESSION_PATH=
# сообщений канала за запуск(50), окно отслеживания правок(30), предел видео в МБ(50), тайм-аут загрузки в секундах(300)
TG_HISTORY_LIMIT=
TG_EDIT_WINDOW=
TG_MAX_VIDEO_MB=
TG_DOWNLOAD_TIMEOUT_S=

# ---------- Telegram: предупреждения жителям(Bot API, страница "Жителям") ----------
# токен бота заявок от @BotFather - тот же, что BOT_TOKEN в saq-telegram-bot. API и воркер только отправляют сообщения
# (sendMessage) и не читают обновления: long polling бота не прерывается. Пусто - отправка не настроена
BOT_TOKEN=
# публичный канал ГАСК: @имя или ID вида -100…; бот - администратор канала с правом публикации. Пусто - только подписчики
TG_ALERTS_CHANNEL=

# ---------- Apify, TikTok(платный сбор) ----------
APIFY_TOKEN=
# по умолчанию clockworks~tiktok-scraper
APIFY_ACTOR_ID=
# лимит расходов на запуск(0.5 USD) и на день(1.0 USD); публикаций на профиль(5); тайм-аут запуска в секундах(300).
# Расписание Apify(Schedule) не создавать: сбор запускает только воркер. После ошибки или HTTP 402 платный сбор
# останавливается до успешной ручной проверки.
APIFY_MAX_TOTAL_CHARGE_USD=
APIFY_DAILY_BUDGET_USD=
APIFY_MAX_ITEMS_PER_PROFILE=
APIFY_RUN_TIMEOUT_S=

# ---------- 2ГИС - геокодер(кандидаты адресов для карточки ЖК) ----------
DGIS_API_KEY=
# квота ключа за период(900) с даты ГГГГ-ММ-ДД, дневной предел(50), срок кэша кандидатов в днях(7)
DGIS_QUOTA_LIMIT=
DGIS_QUOTA_PERIOD_START=
DGIS_DAILY_LIMIT=
DGIS_CACHE_TTL_DAYS=

# ---------- Krisha.kz(HTML-сборщик выдачи, API нет; обход проверок доступа не выполняется) ----------
# пауза между запросами в секундах(5), страниц выдачи(2), карточек за запуск(10)
KRISHA_MIN_DELAY_S=
KRISHA_MAX_PAGES=
KRISHA_MAX_CARDS=
# 1 - загрузка закрытой карточки через Playwright с выключенным JavaScript(не входит в зависимости, ставится
# отдельно; этот путь не проверялся)
KRISHA_PLAYWRIGHT=

# ---------- OLX.kz(Partner API, OAuth; заполнить после одобрения заявки) ----------
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# публичный Callback URI(ngrok): через этот хост доступен только путь обратного вызова. Callback URI заявки:
# https://your-domain.ngrok-free.dev/api/integrations/olx/callback - туннель ngrok вести на порт API 8000
OLX_REDIRECT_URI=
# по умолчанию "read v2"
OLX_SCOPES=

# ---------- Claude(Anthropic) - анализ ИИ публикаций(этап "llm" задания анализа) ----------
# серверный ключ API(console.anthropic.com); без него этап не выполняется, работают только правила saq-ai-1.
# Текст публикации и OCR уходят в Anthropic - см. docs/AI.md, "Анализ Claude"(раздел "Приватность")
ANTHROPIC_API_KEY=
# модель(claude-sonnet-5-5); уровень размышления low | medium | high | xhigh | max(medium)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
# предел токенов ответа вместе с размышлением(16000), тайм-аут запроса в секундах(120)
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_TIMEOUT_S=
# дневной бюджет в долларах США(5.0); 0 - этап выключен. Перед запросом резервируется наихудшая стоимость
ANTHROPIC_DAILY_BUDGET_USD=
# ID рабочего пространства(wrkspc_…) - только для ключа организации, не привязанного к пространству
ANTHROPIC_WORKSPACE_ID=
# дозапрос старых публикаций без ответа Claude в пределах дневного бюджета: публикаций за проход(5; 0 - выключен)
# и пауза между проходами в минутах(10)
ANTHROPIC_BACKFILL_BATCH=
ANTHROPIC_BACKFILL_INTERVAL_MIN=

# ---------- Фото объектов(app.gallery) ----------
# фото карточек Homeportal для ЖК открытого реестра, у которых их ещё нет: раз в N часов(24; 0 - выключено).
# Вручную: кнопка "Фото с Homeportal" в карточке ЖК или python -m app.gallery fetch
SAQ_GALLERY_SYNC_HOURS=

# ---------- Речь в роликах(этап "speech" задания анализа; faster-whisper - бесплатно, локально, на CPU) ----------
# модель faster-whisper: tiny | base | small | medium | large-v3(по умолчанию base); off - распознавание выключено.
# Без пакета faster-whisper или без скачанной модели этап пропускается с пояснением. Модель скачивается с
# huggingface.co один раз командой python -m app.speech download(base ≈ 145 МБ, small ≈ 480 МБ); задание анализа в
# сеть не ходит. Расшифровка добавляется к OCR публикации - с ANTHROPIC_API_KEY уходит в Anthropic вместе с OCR
SAQ_ASR_MODEL=
# каталог моделей; по умолчанию backend/data/models(вне Git; в Docker путь задаёт docker-compose.yml - /data/models
# на томе asrmodels, значение отсюда не действует)
SAQ_ASR_MODEL_DIR=
# ролик длиннее стольких секунд не распознаётся(300); предел времени распознавания одного ролика в секундах(300)
SAQ_ASR_MAX_S=
SAQ_ASR_TIMEOUT_S=

# ---------- Файлы публикаций ----------
# каталог хранилища; по умолчанию backend/data/media(в Docker путь задаёт docker-compose.yml - /data/media на томе media)
MEDIA_ROOT=
# пределы: изображение(10 МБ - не больше предела OCR), видео(200 МБ), свободное место на диске(1024 МБ)
MEDIA_MAX_IMAGE_MB=
MEDIA_MAX_VIDEO_MB=
MEDIA_MIN_FREE_MB=

# ---------- Воркер и служебное ----------
# Пустая БД получает стартовый набор реальных данных shared/snapshot(docs/DATA.md, "Стартовый набор").
# 1 - разрешить пересоздание таблиц при неизвестной версии схемы, даже если в базе есть собранные данные
SAQ_ALLOW_SCHEMA_RESET=
# 1 - собранные публикации получают привязку-гипотезу к ЖК автоматически(для демонстрации; не подтверждение)
SAQ_COLLECTED_AUTOLINK=
# адреса интерфейса на другом домене(сборка с абсолютным VITE_API_URL), которым API отвечает с CORS: через запятую,
# как в адресной строке без пути, например https://saq.example.kz. Пусто - CORS выключен: интерфейс ходит на /api
# своего адреса(прокси Vite или общий веб-сервер), и чужая страница в браузере аналитика не прочитает ответы API;
# * - любой адрес. Имя хоста из VITE_API_URL, если это не localhost и не IP, - в SAQ_WEB_HOSTS:
# иначе API отклонит запрос(400)
SAQ_CORS_ORIGINS=
# "Проверка по рекламе": свежая реклама - опубликованная не раньше стольких дней назад(по умолчанию 120)
SAQ_SCREENING_DAYS=
# пауза опроса очереди в секундах(5), имя воркера(по умолчанию имя хоста)
SAQ_WORKER_POLL_S=
SAQ_WORKER_ID=
# блокировка задания(1800 с) и предел продления для одного задания(3600 с)
SAQ_JOB_LEASE_S=
SAQ_JOB_MAX_S=
# User-Agent сборщиков, только ASCII
SAQ_USER_AGENT=
# другой файл настроек вместо этого .env; пустая строка в окружении - файл не читается
SAQ_ENV_FILE=

# ---------- Telegram-бот заявок ----------
# Эти имена читает отдельный проект saq-telegram-bot, не этот API(здесь - для справки; BOT_TOKEN - выше, его читают оба):
# ADMIN_USER_IDS=
# ADMIN_CHAT_ID=
# SERVICE_URL=
# SERVICE_API_TOKEN=
